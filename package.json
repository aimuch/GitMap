{
  "name": "open-notion",
  "productName": "OpenNotion",
  "desktopName": "open-notion.desktop",
  "description": "运行在本机的块编辑笔记工作区",
  "author": "OpenNotion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && vite preview",
    "typecheck": "tsc --noEmit",
    "desktop:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist-electron/main.cjs",
    "desktop:build": "npm run build && npm run desktop:main",
    "desktop": "npm run desktop:build && electron .",
    "dist:mac": "npm run desktop:build && electron-builder --mac",
    "dist:win": "npm run desktop:build && electron-builder --win --x64",
    "dist:linux": "npm run desktop:build && electron-builder --linux --x64",
    "dist:win:zip": "npm run desktop:build && electron-builder --win zip --x64",
    "dist:linux:tar": "npm run desktop:build && electron-builder --linux tar.gz --x64"
  },
  "build": {
    "appId": "local.opennotion.desktop",
    "productName": "OpenNotion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "icon": "build/icon.png",
      "category": "Office",
      "syncDesktopName": true
    }
  },
  "devDependencies": {
    "@blocknote/code-block": "^0.57.0",
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
